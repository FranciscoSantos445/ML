    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python Debugger: Current File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "dependencies": {
                "debugpy": "1.8.5" , 
                "numpy": "1.21.2",
                "pandas": "1.3.3",
                "scikit-learn": "0.24.2",
                "new_package": "1.0.0"
            }
        }
    ]
}